#!/usr/bin/env bash
# Hypr App Switcher launcher: support either Quickshell executable name.
# The application is managed separately from the main Serpantinum shell.
set -euo pipefail

dir="${XDG_DATA_HOME:-$HOME/.local/share}/hypr-app-switcher"
if [[ ! -f "$dir/shell.qml" ]]; then
    printf 'Hypr App Switcher not installed: %s\n' "$dir" >&2
    exit 1
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if command -v qs >/dev/null 2>&1; then
    quickshell_bin="$(command -v qs)"
elif command -v quickshell >/dev/null 2>&1; then
    quickshell_bin="$(command -v quickshell)"
else
    printf 'Quickshell not found (neither qs nor quickshell).\n' >&2
    exit 1
fi

case "${1:-}" in
    start)
        # VirtualBox has incomplete virtual GPU support for some Qt Quick surfaces.
        # Match Serpantinum's known working guest workaround without affecting hardware.
        virtualbox=0
        if command -v systemd-detect-virt >/dev/null 2>&1 &&
           [[ "$(systemd-detect-virt --vm 2>/dev/null || true)" == "oracle" ]]; then
            virtualbox=1
        elif [[ -r /sys/class/dmi/id/product_name ]] &&
             grep -qi 'virtualbox' /sys/class/dmi/id/product_name; then
            virtualbox=1
        fi
        if (( virtualbox )); then
            export QT_QUICK_BACKEND="${SERP_APP_SWITCHER_QT_BACKEND:-software}"
        fi

        log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum"
        mkdir -p "$log_dir"
        export QSG_INFO=1
        {
            printf '[%s] Hypr App Switcher start (backend=%s, virtualbox=%s)\n' \
                "$(date -Is)" "${QT_QUICK_BACKEND:-default}" "$virtualbox"
        } >>"$log_dir/app-switcher.log"
        exec "$quickshell_bin" -p "$dir" >>"$log_dir/app-switcher.log" 2>&1
        ;;
    next|prev|toggle|close|release|select)
        exec "$quickshell_bin" ipc -p "$dir" --any-display call app-switcher "$1"
        ;;
    *)
        printf 'Usage: serpantinum-app-switcher {start|next|prev|toggle|close|release|select}\n' >&2
        exit 2
        ;;
esac
