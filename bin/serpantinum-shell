#!/usr/bin/env bash
# Start the official Serpantinum Quickshell inside the Hyprland Wayland session.
# VirtualBox uses Mesa Lavapipe so Qt keeps its complete Vulkan effects without
# relying on the VM's unreliable virtual OpenGL/EGL surface.
set -euo pipefail

# Keep a startup trace for cases where Hyprland starts the shell too early.
# Direct terminal use remains interactive and displays logs normally.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum"
mkdir -p "$state_dir"
if [[ ! -t 1 ]]; then
    exec >>"$state_dir/shell-autostart.log" 2>&1
fi
printf '[%s] Starting Serpantinum shell wrapper\n' "$(date -Is)"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland

# Hyprland's start event may fire before its socket is ready (VirtualBox).
# Poll rather than exiting and leaving a black desktop.
ready=0
for (( attempt=1; attempt<=60; attempt++ )); do
    if command -v hyprctl >/dev/null 2>&1; then
        instances="$(hyprctl instances 2>/dev/null || true)"
        signature="$(printf '%s\n' "$instances" | awk '/^instance / {gsub(/:/, "", $2); print $2; exit}')"
        socket="$(printf '%s\n' "$instances" | awk '/wl socket:/ {print $3; exit}')"
        [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -n "$signature" ]] &&
            export HYPRLAND_INSTANCE_SIGNATURE="$signature"
        [[ -z "${WAYLAND_DISPLAY:-}" && -n "$socket" ]] &&
            export WAYLAND_DISPLAY="$socket"
    fi

    if [[ -n "${WAYLAND_DISPLAY:-}" ]] &&
       [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
        ready=1
        break
    fi
    sleep 0.5
done

if (( ! ready )); then
    printf 'Serpantinum: socket Wayland indisponible apres 30 secondes.\n' >&2
    exit 1
fi

# Let the compositor finish initializing its graphical services.
sleep 1
printf '[%s] Wayland ready: %s\n' "$(date -Is)" "$WAYLAND_DISPLAY"

# Use a complete software Vulkan implementation inside VirtualBox. Unlike
# QT_QUICK_BACKEND=software, Lavapipe supports the ShaderEffect/MultiEffect
# path used by Serpantinum for masks, rounded corners and transitions.
is_virtualbox=0
if command -v systemd-detect-virt >/dev/null 2>&1 &&
   [[ "$(systemd-detect-virt --vm 2>/dev/null || true)" == "oracle" ]]; then
    is_virtualbox=1
elif [[ -r /sys/class/dmi/id/product_name ]] &&
     grep -qi 'virtualbox' /sys/class/dmi/id/product_name; then
    is_virtualbox=1
fi

if (( is_virtualbox )); then
    lavapipe_icd=""
    for candidate in \
        /usr/share/vulkan/icd.d/lvp_icd*.json \
        /etc/vulkan/icd.d/lvp_icd*.json \
        /usr/share/vulkan/icd.d/lavapipe_icd*.json \
        /etc/vulkan/icd.d/lavapipe_icd*.json; do
        if [[ -f "$candidate" ]]; then
            lavapipe_icd="$candidate"
            break
        fi
    done

    if [[ -n "$lavapipe_icd" ]]; then
        unset QT_QUICK_BACKEND
        export QSG_RHI_BACKEND=vulkan
        export VK_DRIVER_FILES="$lavapipe_icd"
        printf '[%s] VirtualBox renderer: Vulkan/Lavapipe (%s)\n' \
            "$(date -Is)" "$lavapipe_icd"
    else
        export QT_QUICK_BACKEND=software
        unset QSG_RHI_BACKEND VK_DRIVER_FILES
        printf 'Serpantinum: Lavapipe absent; repli sur le rendu Qt software.\n' >&2
    fi
fi

daemon="$HOME/.local/share/serpantinum/bin/serpantinumd"
if [[ ! -x "$daemon" ]]; then
    printf 'Serpantinum officiel absent: %s\n' "$daemon" >&2
    exit 1
fi

exec "$daemon" start
