#!/usr/bin/env bash
# Serpantinum — small management CLI.
#
# Usage: serpantinum {status|reload|wallpaper|doctor}
set -euo pipefail

SERP_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/serpantinum"
WALLPAPER="$DATA_DIR/wallpapers/serpantinum.jpg"

# Allow the CLI to talk to Hyprland from a plain SSH session.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "$XDG_RUNTIME_DIR/hypr" ]]; then
    HYPRLAND_INSTANCE_SIGNATURE="$(ls -1 "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -n1)"
    export HYPRLAND_INSTANCE_SIGNATURE
fi

case "${1:-status}" in
    status)
        # shellcheck source=lib/status.sh
        source "$SERP_ROOT/lib/status.sh"
        print_status
        ;;
    reload)
        hyprctl reload && echo "Hyprland recharge"
        ;;
    wallpaper)
        [[ -f "$WALLPAPER" ]] || { echo "fond d'ecran introuvable: $WALLPAPER" >&2; exit 1; }
        pkill -x swaybg 2>/dev/null || true
        hyprctl dispatch "hl.dsp.exec_cmd(\"swaybg -i '$WALLPAPER' -m fill\")" >/dev/null
        echo "fond d'ecran applique: $WALLPAPER"
        ;;
    doctor)
        # shellcheck source=../lib/detect.sh
        source "$SERP_ROOT/lib/detect.sh"
        detect_environment
        echo "== Serpantinum doctor =="
        echo "-- paquets ($SERP_PKG_FAMILY) --"
        if [[ -n "$SERP_PKG_CMD" && -f "$SERP_DEPS_FILE" ]]; then
            while IFS= read -r pkg; do
                [[ -z "$pkg" || "$pkg" == \#* ]] && continue
                if pkg_installed "$pkg"; then
                    printf '  ok      %s\n' "$pkg"
                else
                    printf '  manque  %s\n' "$pkg"
                fi
            done < "$SERP_DEPS_FILE"
        else
            echo "  (distribution non reconnue: verification des paquets ignoree)"
        fi
        echo "-- liens --"
        for f in "$HOME/.zshrc" "$HOME/.vimrc" \
                 "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" \
                 "$HOME/.local/bin/serpantinum-snap"; do
            if [[ -L "$f" && -e "$f" ]]; then
                printf '  ok      %s -> %s\n' "$f" "$(readlink "$f")"
            elif [[ -e "$f" ]]; then
                printf '  fichier %s (non lie)\n' "$f"
            else
                printf '  manque  %s\n' "$f"
            fi
        done
        echo "-- etat --"
        [[ -f "$STATE_DIR/installed" ]] \
            && echo "  installe le $(cat "$STATE_DIR/installed")" \
            || echo "  non installe"
        ;;
    *)
        echo "usage: serpantinum {status|reload|wallpaper|doctor}" >&2
        exit 2
        ;;
esac
