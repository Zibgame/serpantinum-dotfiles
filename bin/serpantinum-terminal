#!/usr/bin/env bash
# Serpantinum terminal launcher.
# VirtualBox: use Foot directly; Kitty's GPU backend can open and crash.
# Other systems: prefer Kitty, fall back to Foot if Kitty fails.
set -uo pipefail

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum"
mkdir -p "$log_dir"
log="$log_dir/kitty.log"

is_virtualbox=0
if command -v systemd-detect-virt >/dev/null 2>&1 &&
   [[ "$(systemd-detect-virt --vm 2>/dev/null || true)" == "oracle" ]]; then
    is_virtualbox=1
elif [[ -r /sys/class/dmi/id/product_name ]] &&
     grep -qi 'virtualbox' /sys/class/dmi/id/product_name; then
    is_virtualbox=1
fi

if (( is_virtualbox )) && command -v foot >/dev/null 2>&1; then
    exec foot "$@"
fi

if command -v kitty >/dev/null 2>&1; then
    status=0
    kitty "$@" 2>>"$log" || status=$?
    if (( status == 0 )); then
        exit 0
    fi
    printf 'Kitty a echoue (code %s). Log: %s. Repli vers Foot.\n' "$status" "$log" >&2
fi

if command -v foot >/dev/null 2>&1; then
    exec foot "$@"
fi

printf 'Impossible d ouvrir un terminal: ni Kitty ni Foot disponibles.\n' >&2
exit 1
