#!/usr/bin/env bash
# Serpantinum — Windows/Ubuntu-like window snapping for floating windows.
#
# Usage: serpantinum-snap left|right|top|max|center|down|minimize|restore|forget|ensure-visible|monitor-left|monitor-right
set -euo pipefail

mode="${1:-}"
case "$mode" in
    left|right|top|max|center|down|minimize|restore|forget|ensure-visible|monitor-left|monitor-right) ;;
    *)
        echo "usage: serpantinum-snap left|right|top|max|center|down|minimize|restore|forget|ensure-visible|monitor-left|monitor-right" >&2
        exit 2
        ;;
esac

command -v hyprctl >/dev/null 2>&1 || exit 0

# Give Hyprland a moment to finish restoring the floating geometry.
if [[ "$mode" == "ensure-visible" ]]; then
    sleep 0.2
fi

window_json="$(hyprctl -j activewindow)"
read -r addr window_pid fullscreen <<<"$(printf '%s' "$window_json" | python3 -c '
import json, sys
window = json.load(sys.stdin)
print(window.get("address", ""), window.get("pid", 0), window.get("fullscreen", 0))
')"
[[ -n "$addr" ]] || exit 0

geometry_dir="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum/window-geometry"
geometry_file="$geometry_dir/${addr#0x}"

save_geometry() {
    local saved_pid="" x y w h temp_file
    if [[ -f "$geometry_file" ]]; then
        read -r saved_pid _ < "$geometry_file" || true
        [[ "$saved_pid" == "$window_pid" ]] && return 0
    fi

    read -r x y w h <<<"$(hyprctl -j activewindow | python3 -c '
import json, sys
window = json.load(sys.stdin)
x, y = window.get("at") or (0, 0)
w, h = window.get("size") or (1, 1)
print(int(x), int(y), int(w), int(h))
')"
    mkdir -p "$geometry_dir"
    temp_file="$geometry_file.$$.tmp"
    printf '%s %s %s %s %s\n' "$window_pid" "$x" "$y" "$w" "$h" > "$temp_file"
    mv -f "$temp_file" "$geometry_file"
}

restore_geometry() {
    local saved_pid x y w h value
    [[ -f "$geometry_file" ]] || return 1
    read -r saved_pid x y w h < "$geometry_file" || return 1
    [[ "$saved_pid" == "$window_pid" ]] || return 1
    for value in "$x" "$y" "$w" "$h"; do
        [[ "$value" =~ ^-?[0-9]+$ ]] || return 1
    done
    (( w > 0 && h > 0 )) || return 1

    hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = 'address:$addr' })" >/dev/null
    hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = 'address:$addr' })" >/dev/null
    rm -f "$geometry_file"
}

minimize_window() {
    hyprctl dispatch "hl.dsp.window.tag({ tag = '+minimized', window = 'address:$addr' })" >/dev/null
    hyprctl dispatch "hl.dsp.window.move({ workspace = 'special:minimized', follow = false, window = 'address:$addr' })" >/dev/null
}

if [[ "$mode" == "forget" ]]; then
    rm -f "$geometry_file"
    exit 0
fi

if [[ "$mode" == "minimize" ]]; then
    minimize_window
    exit 0
fi

if [[ "$mode" == "restore" ]]; then
    if restore_geometry; then
        sleep 0.1
        exec "$0" ensure-visible
    fi
    exit 0
fi

# Super+Down follows the Windows/Ubuntu state cycle. Native maximize and
# fullscreen states are restored first. A snapped window then returns to its
# saved floating geometry. A normal window is minimized on the final press.
if [[ "$mode" == "down" ]]; then
    case "${fullscreen:-0}" in
        1)
            hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset', mode = 1 })" >/dev/null
            sleep 0.2
            exec "$0" ensure-visible
            ;;
        2)
            hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset' })" >/dev/null
            sleep 0.2
            exec "$0" ensure-visible
            ;;
        3)
            hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset' })" >/dev/null
            hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset', mode = 1 })" >/dev/null
            sleep 0.2
            exec "$0" ensure-visible
            ;;
    esac

    if restore_geometry; then
        sleep 0.1
        exec "$0" ensure-visible
    fi
    minimize_window
    exit 0
fi

# A maximized/fullscreen window refuses move/resize: restore it first.
# The fullscreen dispatcher only acts on the active window (no window selector).
#   fs 1 = maximized  -> unset with mode 1
#   fs 2 = fullscreen -> plain unset
#   fs 3 = both       -> both
case "${fullscreen:-0}" in
    1) hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset', mode = 1 })" >/dev/null; sleep 0.3 ;;
    2) hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset' })" >/dev/null; sleep 0.3 ;;
    3) hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset' })" >/dev/null
       hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset', mode = 1 })" >/dev/null
       sleep 0.3 ;;
esac

case "$mode" in
    left|right|top|max|center) save_geometry ;;
esac

if [[ "$mode" == monitor-* ]]; then
    direction="${mode#monitor-}"
    target="$(hyprctl -j monitors | python3 - "$direction" <<'PY'
import json, sys
direction = sys.argv[1]
mons = json.load(sys.stdin)
current = next((m for m in mons if m.get("focused")), None)
if current is None or len(mons) < 2:
    print("")
    raise SystemExit
cx = current["x"]
candidates = []
for m in mons:
    if m is current:
        continue
    if direction == "right" and m["x"] > cx:
        candidates.append(m)
    elif direction == "left" and m["x"] < cx:
        candidates.append(m)
if not candidates:
    print("")
    raise SystemExit
pick = min(candidates, key=lambda m: abs(m["x"] - cx))
print(pick["name"])
PY
)"
    [[ -n "$target" ]] || exit 0
    hyprctl dispatch "hl.dsp.window.move({ monitor = '$target', window = 'address:$addr' })" >/dev/null
    exit 0
fi

# Use the monitor's actual work area, not its full resolution.
# Hyprland reports reserved edges as [left, top, right, bottom] (layer-shell
# panels/docks). In VirtualBox/Quickshell the top bar can be visible before
# its reservation reaches Hyprland; preserve a 32px fallback in that case.
# Set SERPANTINUM_TOP_BAR_HEIGHT to override the fallback if bar size changes.
bar_running=0
if pgrep -u "$(id -u)" -x quickshell >/dev/null 2>&1; then
    bar_running=1
fi
read -r mx my mw mh <<<"$(hyprctl -j monitors | python3 -c '
import json, os, sys

monitors = json.load(sys.stdin)
if not monitors:
    sys.exit("No active monitor")
m = next((item for item in monitors if item.get("focused")), monitors[0])
reserved = m.get("reserved") or [0, 0, 0, 0]
left, top, right, bottom = (int(value) for value in reserved)
if sys.argv[1] == "1":
    bar_height = max(0, int(os.environ.get("SERPANTINUM_TOP_BAR_HEIGHT", "32")))
    top = max(top, bar_height)

scale = float(m.get("scale") or 1)
width = int(m["width"] / scale)
height = int(m["height"] / scale)
x = int(m["x"]) + left
y = int(m["y"]) + top
w = max(1, width - left - right)
h = max(1, height - top - bottom)
print(x, y, w, h)
' "$bar_running")"

# On Super+Down, Hyprland restores the previous floating geometry.
# If it overlaps the bar or extends beyond the work area, clamp only the
# overflowing edges. Otherwise leave the window size and position unchanged.
if [[ "$mode" == "ensure-visible" ]]; then
    read -r wx wy ww wh <<<"$(hyprctl -j activewindow | python3 -c '
import json, sys
window = json.load(sys.stdin)
x, y = window.get("at") or (0, 0)
w, h = window.get("size") or (1, 1)
print(int(x), int(y), int(w), int(h))
')"

    w=$ww
    h=$wh
    (( w > mw )) && w=$mw
    (( h > mh )) && h=$mh
    (( w < 1 )) && w=1
    (( h < 1 )) && h=1

    x=$wx
    y=$wy
    (( x < mx )) && x=$mx
    (( y < my )) && y=$my
    (( x + w > mx + mw )) && x=$((mx + mw - w))
    (( y + h > my + mh )) && y=$((my + mh - h))

    if (( w != ww || h != wh )); then
        hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = 'address:$addr' })" >/dev/null
    fi
    if (( x != wx || y != wy )); then
        hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = 'address:$addr' })" >/dev/null
    fi
    exit 0
fi

case "$mode" in
    left)
        x=$mx; y=$my; w=$((mw / 2)); h=$mh
        ;;
    right)
        x=$((mx + mw / 2)); y=$my; w=$((mw / 2)); h=$mh
        ;;
    top)
        # Legacy top-half mode retained for direct callers. Super+Up now uses
        # Hyprland's native maximized state from serpantinum-keybinds.lua.
        top_state="$(hyprctl -j activewindow | python3 -c '
import json, sys
window = json.load(sys.stdin)
mx, my, mw, mh = map(int, sys.argv[1:5])
x, y = map(int, window.get("at") or (-10000, -10000))
w, h = map(int, window.get("size") or (0, 0))
near = lambda a, b: abs(a - b) <= 16
aligned = near(x, mx) and near(y, my) and near(w, mw)
half_w = mw // 2
if aligned and near(h, mh // 2):
    print("top-half")
elif aligned and near(h, mh):
    print("full")
elif near(y, my) and near(h, mh):
    if near(x, mx) and near(w, half_w):
        print("full-left")
    elif near(x, mx + half_w) and near(w, mw - half_w):
        print("full-right")
    else:
        print("other")
else:
    print("other")
' "$mx" "$my" "$mw" "$mh")"
        x=$mx; y=$my; w=$mw
        if [[ "$top_state" == "top-half" || "$top_state" == "full" ||
              "$top_state" == "full-left" || "$top_state" == "full-right" ]]; then
            h=$mh
        else
            h=$((mh / 2))
        fi
        ;;
    max)
        x=$mx; y=$my; w=$mw; h=$mh
        ;;
    center)
        w=$((mw * 3 / 5)); h=$((mh * 3 / 4))
        x=$((mx + (mw - w) / 2)); y=$((my + (mh - h) / 2))
        ;;
esac

# Resize first, then move: resizing can shift the window slightly.
hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = 'address:$addr' })" >/dev/null
hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = 'address:$addr' })" >/dev/null
