#!/usr/bin/env bash
# Serpantinum — Ubuntu-like window snapping for floating windows.
#
# Usage: serpantinum-snap left|right|top|max|center|ensure-visible|monitor-left|monitor-right
set -euo pipefail

mode="${1:-}"
case "$mode" in
    left|right|top|max|center|ensure-visible|monitor-left|monitor-right) ;;
    *)
        echo "usage: serpantinum-snap left|right|top|max|center|ensure-visible|monitor-left|monitor-right" >&2
        exit 2
        ;;
esac

command -v hyprctl >/dev/null 2>&1 || exit 0

# Give Hyprland a moment to finish restoring the floating geometry.
if [[ "$mode" == "ensure-visible" ]]; then
    sleep 0.2
fi

addr="$(hyprctl -j activewindow | python3 -c 'import json,sys; print(json.load(sys.stdin).get("address",""))')"
[[ -n "$addr" ]] || exit 0

# A maximized/fullscreen window refuses move/resize: restore it first.
# The fullscreen dispatcher only acts on the active window (no window selector).
#   fs 1 = maximized  -> unset with mode 1
#   fs 2 = fullscreen -> plain unset
#   fs 3 = both       -> both
fullscreen="$(hyprctl -j activewindow | python3 -c 'import json,sys; print(json.load(sys.stdin).get("fullscreen",0))')"
case "${fullscreen:-0}" in
    1) hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset', mode = 1 })" >/dev/null; sleep 0.3 ;;
    2) hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset' })" >/dev/null; sleep 0.3 ;;
    3) hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset' })" >/dev/null
       hyprctl dispatch "hl.dsp.window.fullscreen({ action = 'unset', mode = 1 })" >/dev/null
       sleep 0.3 ;;
esac

if [[ "$mode" == monitor-* ]]; then
    direction="${mode#monitor-}"
    target="$(hyprctl -j monitors | python3 - "$direction" <<'PY'
import json, sys
direction = sys.argv[1]
mons = json.load(sys.stdin)
current = next((m for m in mons if m.get("focused")), None)
if current is None or len(mons) < 2:
    print("")
    raise SystemExit
cx = current["x"]
candidates = []
for m in mons:
    if m is current:
        continue
    if direction == "right" and m["x"] > cx:
        candidates.append(m)
    elif direction == "left" and m["x"] < cx:
        candidates.append(m)
if not candidates:
    print("")
    raise SystemExit
pick = min(candidates, key=lambda m: abs(m["x"] - cx))
print(pick["name"])
PY
)"
    [[ -n "$target" ]] || exit 0
    hyprctl dispatch "hl.dsp.window.move({ monitor = '$target', window = 'address:$addr' })" >/dev/null
    exit 0
fi

# Use the monitor's actual work area, not its full resolution.
# Hyprland reports reserved edges as [left, top, right, bottom] (layer-shell
# panels/docks). In VirtualBox/Quickshell the top bar can be visible before
# its reservation reaches Hyprland; preserve a 32px fallback in that case.
# Set SERPANTINUM_TOP_BAR_HEIGHT to override the fallback if bar size changes.
bar_running=0
if pgrep -u "$(id -u)" -x quickshell >/dev/null 2>&1; then
    bar_running=1
fi
read -r mx my mw mh <<<"$(hyprctl -j monitors | python3 -c '
import json, os, sys

monitors = json.load(sys.stdin)
if not monitors:
    sys.exit("No active monitor")
m = next((item for item in monitors if item.get("focused")), monitors[0])
reserved = m.get("reserved") or [0, 0, 0, 0]
left, top, right, bottom = (int(value) for value in reserved)
if sys.argv[1] == "1":
    bar_height = max(0, int(os.environ.get("SERPANTINUM_TOP_BAR_HEIGHT", "32")))
    top = max(top, bar_height)

scale = float(m.get("scale") or 1)
width = int(m["width"] / scale)
height = int(m["height"] / scale)
x = int(m["x"]) + left
y = int(m["y"]) + top
w = max(1, width - left - right)
h = max(1, height - top - bottom)
print(x, y, w, h)
' "$bar_running")"

# On Super+Down, Hyprland restores the previous floating geometry.
# If it overlaps the bar or extends beyond the work area, clamp only the
# overflowing edges. Otherwise leave the window size and position unchanged.
if [[ "$mode" == "ensure-visible" ]]; then
    read -r wx wy ww wh <<<"$(hyprctl -j activewindow | python3 -c '
import json, sys
window = json.load(sys.stdin)
x, y = window.get("at") or (0, 0)
w, h = window.get("size") or (1, 1)
print(int(x), int(y), int(w), int(h))
')"

    w=$ww
    h=$wh
    (( w > mw )) && w=$mw
    (( h > mh )) && h=$mh
    (( w < 1 )) && w=1
    (( h < 1 )) && h=1

    x=$wx
    y=$wy
    (( x < mx )) && x=$mx
    (( y < my )) && y=$my
    (( x + w > mx + mw )) && x=$((mx + mw - w))
    (( y + h > my + mh )) && y=$((my + mh - h))

    if (( w != ww || h != wh )); then
        hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = 'address:$addr' })" >/dev/null
    fi
    if (( x != wx || y != wy )); then
        hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = 'address:$addr' })" >/dev/null
    fi
    exit 0
fi

# Stateful-by-geometry snapping for floating windows:
# top wide -> upper-left/right quarter;
# upper-left + LEFT or upper-right + RIGHT -> expand to a tall side half;
# tall-left + RIGHT -> return to upper-left quarter (reverse the expansion);
# tall-right + LEFT -> return to upper-right quarter (reverse expansion);
# opposite arrow on a small upper quarter moves to the other upper quarter.
# Detect per-window geometry, never a shared global flag.
snap_state="other"
if [[ "$mode" == "left" || "$mode" == "right" ]]; then
    snap_state="$(hyprctl -j activewindow | python3 -c '
import json, sys
win = json.load(sys.stdin)
mx, my, mw, mh = map(int, sys.argv[1:5])
x, y = map(int, win.get("at") or (-10000, -10000))
w, h = map(int, win.get("size") or (0, 0))
near = lambda a, b: abs(a - b) <= 12
half_w, half_h = mw // 2, mh // 2
if near(y, my):
    if near(h, half_h):
        if near(x, mx) and near(w, mw):
            print("top")
        elif near(x, mx) and near(w, half_w):
            print("top-left")
        elif near(x, mx + half_w) and near(w, mw - half_w):
            print("top-right")
        else:
            print("other")
    elif near(h, mh):
        if near(x, mx) and near(w, half_w):
            print("full-left")
        elif near(x, mx + half_w) and near(w, mw - half_w):
            print("full-right")
        else:
            print("other")
    else:
        print("other")
else:
    print("other")
' "$mx" "$my" "$mw" "$mh")"
fi

case "$mode" in
    left)
        x=$mx; y=$my; w=$((mw / 2)); h=$mh
        if [[ "$snap_state" == "full-right" ]]; then
            # Reverse a right-side expansion: return to the RIGHT upper quarter.
            x=$((mx + mw / 2)); w=$((mw - mw / 2)); h=$((mh / 2))
        elif [[ "$snap_state" == "top" || "$snap_state" == "top-right" ]]; then
            # From top-wide or the other upper corner, stay compact.
            h=$((mh / 2))
        fi
        ;;
    right)
        x=$((mx + mw / 2)); y=$my; w=$((mw - mw / 2)); h=$mh
        if [[ "$snap_state" == "full-left" ]]; then
            # Reverse a left-side expansion: return to the LEFT upper quarter.
            x=$mx; w=$((mw / 2)); h=$((mh / 2))
        elif [[ "$snap_state" == "top" || "$snap_state" == "top-left" ]]; then
            h=$((mh / 2))
        fi
        ;;
    top)
        # Upper half of the work area below the Serpantinum panel.
        x=$mx; y=$my; w=$mw; h=$((mh / 2))
        ;;
    max)
        x=$mx; y=$my; w=$mw; h=$mh
        ;;
    center)
        w=$((mw * 3 / 5)); h=$((mh * 3 / 4))
        x=$((mx + (mw - w) / 2)); y=$((my + (mh - h) / 2))
        ;;
esac

# Resize first, then move: resizing can shift the window slightly.
hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = 'address:$addr' })" >/dev/null
hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = 'address:$addr' })" >/dev/null
